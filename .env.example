# Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Connection Pool Settings
CONNECTION_KEEP_ALIVE_TIMEOUT=30000
CONNECTION_KEEP_ALIVE_MAX_TIMEOUT=60000
CONNECTION_MAX_CONNECTIONS=64
CONNECTION_PIPELINING=1

# ===========================================
# API KEYS - Replace with your actual keys
# Required providers (at least one should be configured)
# ===========================================

# OpenRouter API Key (free tier available)
OPENROUTER_KEY=sk-or-v1-your-key-here

# Google (Gemini) API Key (free tier available)
# Get from: https://aistudio.google.com/apikey
GOOGLE_KEY=AQ.your-key-here

# Agnes API Key
AGNES_KEY=sk-y-your-key-here

# HCNSEC API Key
HCNSEC_KEY=sk-your-key-here

# ===========================================
# Note: The following providers have been removed due to connectivity issues:
# - Crowllm (403 errors)
# - Logfare (unreachable)
# - Uglycat (403 errors)
# - Fxqidian (401 errors)
# - Zydit (403 errors)
# ===========================================
